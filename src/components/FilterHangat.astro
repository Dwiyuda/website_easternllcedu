---
// Filter hangat ringan untuk foto (MASTER.md): merah ×1,04, hijau ×0,98, biru ×0,90, lalu saturasi 92%.
---
<svg class="filter-hangat" width="0" height="0" aria-hidden="true" focusable="false">
  <filter id="hangat" color-interpolation-filters="sRGB">
    <feColorMatrix type="matrix" values="1.04 0 0 0 0  0 0.98 0 0 0  0 0 0.90 0 0  0 0 0 1 0" />
    <feColorMatrix type="saturate" values="0.92" />
  </filter>
</svg>

<style>
  .filter-hangat { position: absolute; width: 0; height: 0; }
</style>
