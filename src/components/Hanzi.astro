---
// Hanzi judul halaman ditulis urut goresan sekali (MASTER.md). Data goresan disimpan sendiri, lisensi di /lisensi/arphic.txt.
import { svgHanzi, type DataHanzi } from '../lib/hanzi';

const SEMUA = import.meta.glob<DataHanzi>('../data/hanzi/*.json', { eager: true, import: 'default' });

interface Props { aksara: string; warna?: 'marun' | 'terang'; kerangka?: boolean }
const { aksara, warna = 'marun', kerangka = true } = Astro.props;
const daftar = [...aksara].map((c) => {
  const data = SEMUA[`../data/hanzi/${c}.json`];
  if (!data) throw new Error(`Data goresan ${c} belum disalin. Tambahkan ke scripts/salin-aset.mjs`);
  return { c, data };
});
---
<span class:list={['hanzi', `hanzi-${warna}`]} data-hanzi data-kerangka={kerangka ? '1' : '0'} aria-hidden="true">
  {daftar.map(({ c, data }) => (
    <span class="aksara" data-aksara={c}>
      <Fragment set:html={svgHanzi(data)} />
      <script type="application/json" set:html={JSON.stringify(data)} />
    </span>
  ))}
</span>

<style>
  .hanzi { display: inline-flex; gap: calc(var(--ukuran-hanzi) * 0.08); }
  .aksara { display: block; width: var(--ukuran-hanzi); height: var(--ukuran-hanzi); color: var(--warna-gores); }
  .aksara :global(svg) { width: 100%; height: 100%; fill: currentColor; }
  .hanzi-marun { --warna-gores: var(--marun-600); --warna-kerangka: var(--krem-300); }
  .hanzi-terang { --warna-gores: var(--kartu-100); --warna-kerangka: transparent; }
</style>

<script>
  import HanziWriter from 'hanzi-writer';

  // Diukur di browser (Task 12): 东方 (9 goresan) tertulis dalam ±2 detik, di dalam rentang 1,5–2,5 detik (--durasi-hanzi).
  const KECEPATAN = 2.4;
  const JEDA_GORES = 60;
  // Hanzi Writer menggambar di ukuran tetap, lalu viewBox membuatnya mengikuti kotak CSS (--ukuran-hanzi 112 → 160 px).
  // Tidak membaca clientWidth: aman di wadah yang tersembunyi saat dimuat (lebar 0) dan saat layar melewati 1024 px.
  const UKURAN = 160;

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const wadah of document.querySelectorAll<HTMLElement>('[data-hanzi]')) {
      const gaya = getComputedStyle(wadah);
      const gores = gaya.getPropertyValue('--warna-gores').trim();
      // Hanzi Writer melempar galat untuk warna "transparent" (aksara hilang): tanpa kerangka, warna kerangka diisi warna goresan.
      const kerangka = gaya.getPropertyValue('--warna-kerangka').trim();
      const adaKerangka = wadah.dataset.kerangka === '1' && kerangka !== 'transparent';
      let antrean = Promise.resolve();
      for (const el of wadah.querySelectorAll<HTMLElement>('.aksara')) {
        const data = JSON.parse(el.querySelector('script')!.textContent!);
        el.querySelector('svg')?.remove();
        const penulis = HanziWriter.create(el, el.dataset.aksara!, {
          width: UKURAN, height: UKURAN, padding: 0, showCharacter: false,
          showOutline: adaKerangka, strokeColor: gores, outlineColor: adaKerangka ? kerangka : gores,
          strokeAnimationSpeed: KECEPATAN, delayBetweenStrokes: JEDA_GORES,
          charDataLoader: (_aksara, selesai) => selesai(data),
        });
        el.querySelector('svg')?.setAttribute('viewBox', `0 0 ${UKURAN} ${UKURAN}`);
        antrean = antrean.then(() => new Promise<void>((r) => { penulis.animateCharacter({ onComplete: () => r() }); }));
      }
    }
  }
</script>
