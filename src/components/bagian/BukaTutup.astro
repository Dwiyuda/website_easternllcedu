---
// Buka-tutup <details> bawaan browser dalam kartu (MASTER.md, Halaman Cara Mendaftar; Desain Teknis bagian 5, tanya jawab):
// judul Fraunces marun, panah expand_more berputar 180° saat terbuka.
import Ikon from '../Ikon.astro';
import TeksCampur from '../TeksCampur.astro';
import type { Bahasa } from '../../lib/dua-bahasa';

interface Props { judul: string; bahasa: Bahasa }
const { judul, bahasa } = Astro.props;
---
<details class="kartu buka-tutup">
  <summary><span class="judul"><TeksCampur bahasa={bahasa} teks={judul} /></span><Ikon nama="expand_more" class="panah" /></summary>
  <div class="isi"><slot /></div>
</details>

<style>
  summary { display: flex; align-items: center; justify-content: space-between; gap: var(--ruang-2); min-height: 48px; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .judul { color: var(--marun-600); font: 500 var(--huruf-judul-4) / 1.3 var(--font-judul); font-variation-settings: "SOFT" 100; }
  :lang(zh) .judul { font-family: var(--font-judul-han); font-weight: 400; }
  summary :global(.panah) { color: var(--marun-600); transition: transform var(--durasi-kursor) var(--kurva); }
  details[open] summary :global(.panah) { transform: rotate(180deg); }
  .isi { padding-top: var(--ruang-2); }
</style>
