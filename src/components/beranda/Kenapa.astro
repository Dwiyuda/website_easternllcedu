---
// Kartu teks berjudul (Kenapa Eastern LLC di Beranda; juga alasan, jenis program, jenjang di halaman program). Tanpa ikon hiasan. Slot: isi tambahan di bawah kartu (tautan artikel Kuliah ke Tiongkok).
import TeksCampur from '../TeksCampur.astro';
import type { Bahasa } from '../../lib/dua-bahasa';

interface Alasan { judul: string; bukti: string }
interface Props { bahasa: Bahasa; teks: { judul: string; kalimat?: string; alasan: Alasan[] }; idJudul?: string; peach?: boolean }
const { bahasa, teks, idJudul = 'judul-kenapa', peach = true } = Astro.props;
---
<section class:list={['bagian', { 'bagian-peach': peach }]} aria-labelledby={idJudul}>
  <div class="wadah">
    <div class="judul-bagian"><h2 id={idJudul}>{teks.judul}</h2>{teks.kalimat && <p>{teks.kalimat}</p>}</div>
    <ol class="kisi">
      {teks.alasan.map((a, i) => (
        <li class="kartu" data-muncul style={`--urut: ${i % 4}`}>
          <h3>{a.judul}</h3>
          <p><TeksCampur bahasa={bahasa} teks={a.bukti} /></p>
        </li>
      ))}
    </ol>
    <slot />
  </div>
</section>

<style>
  .kisi { display: grid; gap: var(--ruang-2); }
  @media (min-width: 768px) { .kisi { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1280px) {
    .kisi { grid-template-columns: repeat(4, 1fr); gap: var(--ruang-3); }
    /* Kurang dari empat kartu (Kursus Bahasa: offline dan online berdampingan) mengisi baris, bukan seperempat lebar per kartu. */
    .kisi:not(:has(> :nth-child(4))) { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 1fr; }
    /* Tepat lima kartu (Jenjang kuliah): tiga kolom (3 + 2), bukan empat ditambah satu kartu yatim. Lima kolom (198 px)
       membuat bukti S1 sembilan baris di 1280 dan 1440. */
    .kisi:has(> :nth-child(5):last-child) { grid-template-columns: repeat(3, 1fr); }
  }
  .kisi + :global(*) { margin-top: var(--ruang-5); }
  .kartu { display: grid; align-content: start; justify-items: start; gap: var(--ruang-1); }
  h3 { font-size: var(--huruf-judul-4); line-height: 1.3; }
  /* Tanpa ini aturan global :lang(zh) h3 menang (spesifisitas lebih tinggi) dan judul kartu 中文 jadi 25 px: patah di tengah kata di 4 kolom. */
  :lang(zh) .kartu h3 { font-size: calc(var(--huruf-judul-4) * 0.9); }
  p { color: var(--teks-600); font-size: var(--huruf-kecil); line-height: 1.55; }
</style>
