---
// Kartu program study tour (Naskah Study Tour bagian 3, MASTER.md Kartu): sampul, status otomatis dari tanggal, jenis,
// judul tanpa tanggal, tanggal, rute. Seluruh kartu menautkan detail. Rute sudah dirangkai lib/konten.ts ruteKota.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Ikon from '../Ikon.astro';
import LencanaContoh from '../LencanaContoh.astro';
import LencanaStatus from '../LencanaStatus.astro';
import { UI } from '../../i18n/ui';
import type { Bahasa } from '../../lib/dua-bahasa';
import { formatRentang, type StatusEvent } from '../../lib/tanggal';

interface Props {
  bahasa: Bahasa;
  program: {
    url: string; judul: string; jenis: keyof (typeof UI)['id']['jenisStudyTour']; mulai: string; selesai: string;
    rute: string; sampul: ImageMetadata; contoh: boolean; status: StatusEvent;
  };
}
const { bahasa, program: p } = Astro.props;
---
<a class="kartu kartu-program" href={p.url}>
  <Image src={p.sampul} alt="" widths={[320, 480, 640]} sizes="(min-width: 1024px) 330px, (min-width: 768px) 45vw, 100vw" data-warna="hangat" />
  <span class="lencana-baris"><LencanaStatus bahasa={bahasa} status={p.status} /><span class="lencana">{UI[bahasa].jenisStudyTour[p.jenis]}</span><LencanaContoh bahasa={bahasa} tampil={p.contoh} /></span>
  <span class="judul">{p.judul}</span>
  <span class="baris"><Ikon nama="calendar_month" ukuran={20} />{formatRentang(p.mulai, p.selesai, bahasa)}</span>
  {p.rute && <span class="baris rute"><Ikon nama="location_on" ukuran={20} />{p.rute}</span>}
</a>

<style>
  .kartu-program { display: grid; align-content: start; gap: var(--ruang-2); height: 100%; padding: var(--ruang-1) var(--ruang-1) var(--ruang-3); }
  .kartu-program :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-kecil); }
  .lencana-baris, .judul, .baris { margin-inline: var(--ruang-2); }
  .judul { color: var(--marun-600); font: 500 var(--huruf-judul-4) / 1.3 var(--font-judul); font-variation-settings: "SOFT" 100; }
  :lang(zh) .judul { font-family: var(--font-judul-han); font-weight: 400; }
  .baris { display: flex; align-items: center; gap: var(--ruang-1); color: var(--teks-600); font-size: var(--huruf-kecil); }
</style>
