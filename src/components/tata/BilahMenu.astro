---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Ikon from '../Ikon.astro';
import MenuHP from './MenuHP.astro';
import PemilihBahasa from './PemilihBahasa.astro';
import logo from '../../assets/merek/logo-terang-ringkas.png';
import fotoKursus from '../../assets/foto/kelas-kantor.webp';
import fotoKerjaSama from '../../assets/foto/sekolah-1.webp';
import fotoStudyTour from '../../assets/foto/camp-1.webp';
import fotoKuliah from '../../assets/foto/keberangkatan-1.webp';
import fotoKampus from '../../assets/foto/keberangkatan-2.webp';
import { UI } from '../../i18n/ui';
import { RUTE, rapikan, tandaKini, type KunciRute, type Pasangan } from '../../i18n/rute';
import type { Bahasa } from '../../lib/dua-bahasa';

interface Props { bahasa: Bahasa; pasangan?: Pasangan }
const { bahasa, pasangan } = Astro.props;
const ui = UI[bahasa];
const jalur = rapikan(Astro.url.pathname);
const kini = (k: KunciRute) => tandaKini(jalur, RUTE[k][bahasa]);
const PROGRAM: [KunciRute, ImageMetadata][] = [['kursus', fotoKursus], ['kerjaSama', fotoKerjaSama], ['studyTour', fotoStudyTour], ['kuliah', fotoKuliah], ['kampus', fotoKampus]];
const KEGIATAN: KunciRute[] = ['kabar', 'galeri'];
---
<header class="bilah">
  <div class="wadah dalam">
    <a class="logo" href={RUTE.beranda[bahasa]}>
      <Image src={logo} alt={bahasa === 'zh' ? '东方语言学院 首页' : 'Eastern LLC, Beranda'} height={88} loading="eager" />
    </a>
    <nav class="nav-desktop" aria-label={ui.navUtama}>
      <ul class="menu">
        <li><a href={RUTE.beranda[bahasa]} aria-current={kini('beranda')}>{ui.menu.beranda}</a></li>
        <li><a href={RUTE.tentang[bahasa]} aria-current={kini('tentang')}>{ui.menu.tentang}</a></li>
        <li><button class="pemicu" type="button" popovertarget="panel-program">{ui.menu.program}<Ikon nama="expand_more" ukuran={20} /></button></li>
        <li><button class="pemicu" type="button" popovertarget="panel-kegiatan">{ui.menu.kegiatan}<Ikon nama="expand_more" ukuran={20} /></button></li>
        <li><a href={RUTE.testimoni[bahasa]} aria-current={kini('testimoni')}>{ui.menu.testimoni}</a></li>
        <li><a href={RUTE.kontak[bahasa]} aria-current={kini('kontak')}>{ui.menu.kontak}</a></li>
      </ul>
    </nav>
    <div class="kanan">
      <div class="hanya-desktop"><PemilihBahasa bahasa={bahasa} pasangan={pasangan} /></div>
      <button class="tombol tombol-terang hanya-desktop" type="button" popovertarget="panel-wa">{ui.konsultasi}</button>
      <button class="tombol-menu" type="button" data-buka-menu aria-label={ui.bukaMenu}><Ikon nama="menu" /></button>
    </div>
  </div>
</header>

<div id="panel-program" popover class="panel-menu">
  <div class="kisi-program">
    <div class="pengantar">
      <p>{ui.programPengantar}</p>
      <a href={RUTE.program[bahasa]}>{ui.semuaProgram}</a>
    </div>
    {PROGRAM.map(([k, foto]) => (
      <a class="butir" href={RUTE[k][bahasa]} aria-current={kini(k)}>
        <Image src={foto} alt="" width={96} height={72} densities={[1, 2]} data-warna="hangat" />
        <span><span class="judul">{ui.programButir[k]!.judul}</span><span class="kalimat">{ui.programButir[k]!.kalimat}</span></span>
      </a>
    ))}
  </div>
</div>

<div id="panel-kegiatan" popover class="panel-menu panel-kegiatan">
  <div class="kisi-kegiatan">
    {KEGIATAN.map((k) => (
      <a class="butir" href={RUTE[k][bahasa]} aria-current={kini(k)}>
        <span><span class="judul">{ui.kegiatanButir[k]!.judul}</span><span class="kalimat">{ui.kegiatanButir[k]!.kalimat}</span></span>
      </a>
    ))}
  </div>
</div>

<MenuHP bahasa={bahasa} pasangan={pasangan} />

<style>
  .bilah { position: sticky; top: 0; z-index: var(--z-menu); background: var(--marun-600); color: var(--kartu-100); }
  .dalam { display: flex; align-items: center; justify-content: space-between; gap: var(--ruang-2); min-height: var(--tinggi-bilah); }
  .logo { display: block; }
  .logo :global(img) { width: auto; height: 38px; }
  .logo:focus-visible { outline-color: var(--peach-100); }
  .nav-desktop, .hanya-desktop { display: none; }
  .menu { display: flex; gap: var(--ruang-1); }
  .menu a, .pemicu { display: inline-flex; align-items: center; gap: var(--ruang-1); min-height: 48px; padding-inline: var(--ruang-2); border: 0; border-radius: var(--radius-pil); background: transparent; color: var(--kartu-100); font: 600 var(--huruf-kecil) / 1.2 var(--font-isi); white-space: nowrap; text-decoration: none; cursor: pointer; transition: background-color var(--durasi-kursor) var(--kurva); }
  :lang(zh) .menu a, :lang(zh) .pemicu { font-family: var(--font-isi-han); }
  .menu a:hover, .pemicu:hover { background: var(--marun-500); color: var(--kartu-100); }
  .menu a[aria-current] { background: var(--marun-700); color: var(--kartu-100); }
  /* Pemicu panel memakai tanda halaman aktif bila panelnya memuat halaman ini atau induknya (aria-current "page"/"true").
     Terpisah dari aturan di atas karena browser tanpa :has() membuang seluruh daftar selector. @supports mencegah pemadat CSS
     menggabungkan dua aturan berdeklarasi sama ini kembali menjadi satu daftar. */
  @supports selector(:has(*)) {
    :global(body:has(#panel-program .butir[aria-current])) .pemicu[popovertarget='panel-program'],
    :global(body:has(#panel-kegiatan .butir[aria-current])) .pemicu[popovertarget='panel-kegiatan'] { background: var(--marun-700); color: var(--kartu-100); }
  }
  .menu :focus-visible { outline-color: var(--peach-100); }
  .pemicu :global(svg) { transition: transform var(--durasi-kursor) var(--kurva); }
  :global(body:has(#panel-program:popover-open)) .pemicu[popovertarget='panel-program'],
  :global(body:has(#panel-kegiatan:popover-open)) .pemicu[popovertarget='panel-kegiatan'] { background: var(--marun-700); }
  :global(body:has(#panel-program:popover-open)) .pemicu[popovertarget='panel-program'] :global(svg),
  :global(body:has(#panel-kegiatan:popover-open)) .pemicu[popovertarget='panel-kegiatan'] :global(svg) { transform: rotate(180deg); }
  .kanan { display: flex; align-items: center; gap: var(--ruang-2); }
  .tombol-menu { display: inline-grid; place-items: center; width: 48px; height: 48px; border: 0; border-radius: var(--radius-pil); background: transparent; color: var(--kartu-100); cursor: pointer; transition: background-color var(--durasi-kursor) var(--kurva); }
  .tombol-menu:hover { background: var(--marun-500); }
  .tombol-menu:focus-visible { outline-color: var(--peach-100); }
  @media (min-width: 1024px) {
    .nav-desktop, .hanya-desktop { display: inline-flex; }
    .tombol-menu { display: none; }
  }
  @media (min-width: 1280px) { .logo :global(img) { height: 44px; } }
  /* Teks menu tidak boleh pecah, jadi di 1024–1279 px bilah Indonesia kekurangan ±134 px: rapatkan jarak (logo tetap 38 px, 44 px baru mulai 1280 px). */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .dalam { gap: var(--ruang-1); }
    .menu { gap: 0; }
    .menu a, .pemicu { padding-inline: var(--ruang-1); }
    .kanan { gap: var(--ruang-1); }
  }
  .panel-menu { position: fixed; inset: var(--atas-panel, var(--tinggi-bilah)) auto auto 50%; transform: translateX(-50%); width: min(100% - 2 * var(--tepi), var(--wadah)); margin: 0; padding: var(--ruang-4); border: 0; border-radius: 0 0 var(--radius-besar) var(--radius-besar); background: var(--kartu-100); color: var(--teks-900); }
  .panel-kegiatan { width: min(100% - 2 * var(--tepi), 560px); }
  .kisi-program { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--ruang-2); }
  .kisi-kegiatan { display: grid; gap: var(--ruang-1); }
  .pengantar { display: grid; align-content: start; gap: var(--ruang-2); padding: var(--ruang-3); border-radius: var(--radius-kecil); background: var(--peach-100); }
  .butir { display: flex; align-items: center; gap: var(--ruang-2); padding: var(--ruang-2); border-radius: var(--radius-kecil); color: var(--teks-900); text-decoration: none; transition: background-color var(--durasi-kursor) var(--kurva); }
  .butir:hover { background: var(--krem-200); color: var(--teks-900); }
  /* Butir halaman ini atau induknya memakai keadaan "Ditekan / terpilih" MASTER (krem-300), juga saat kursor di atasnya. */
  .butir:active, .butir[aria-current] { background: var(--krem-300); }
  .butir :global(img) { flex: none; width: 96px; height: 72px; border-radius: var(--radius-kecil); }
  .judul { display: block; color: var(--marun-600); font: 500 var(--huruf-judul-4) / 1.3 var(--font-judul); font-variation-settings: "SOFT" 100; }
  :lang(zh) .judul { font-family: var(--font-judul-han); font-weight: 400; }
  .kalimat { display: block; color: var(--teks-600); font-size: var(--huruf-kecil); line-height: 1.55; }
</style>

<script>
  // Panel menempel di tepi bawah bilah yang sebenarnya. Kalau tawaran 中文 tampil di atas bilah, bilah turun dan tepi bawahnya bukan --tinggi-bilah.
  document.querySelectorAll<HTMLElement>('.panel-menu').forEach((panel) => {
    panel.addEventListener('beforetoggle', (e) => {
      if ((e as ToggleEvent).newState !== 'open') return;
      const bilah = document.querySelector('header.bilah');
      if (bilah) panel.style.setProperty('--atas-panel', `${bilah.getBoundingClientRect().bottom}px`);
    });
  });
</script>
