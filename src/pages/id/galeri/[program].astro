---
import HalamanGaleri from '../../../components/halaman/HalamanGaleri.astro';
import { HALAMAN_PROGRAM, type Program } from '../../../i18n/rute';
import { segmenProgram } from '../../../lib/galeri';

// Empat halaman Galeri per program (Peta Halaman). Segmen = segmen terakhir alamat halaman programnya (/id/galeri/kursus-bahasa).
export function getStaticPaths() {
  return (Object.keys(HALAMAN_PROGRAM) as Program[]).map((program) => ({ params: { program: segmenProgram(program, 'id') }, props: { program } }));
}
const { program } = Astro.props as { program: Program };
---
<HalamanGaleri bahasa="id" program={program} />
